{
  "name": "tabsetu",
  "version": "1.0.2",
  "description": "TabSetu - Save your tabs. Clear your mind.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "build:all": "vite build && node scripts/prepare-browser-builds.mjs",
    "build:chrome": "vite build && node scripts/prepare-browser-builds.mjs --target=chrome",
    "build:firefox": "vite build && node scripts/prepare-browser-builds.mjs --target=firefox",
    "build:safari": "vite build && node scripts/prepare-browser-builds.mjs --target=safari",
    "build:opera": "vite build && node scripts/prepare-browser-builds.mjs --target=opera",
    "package:browsers": "node scripts/prepare-browser-builds.mjs",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "type-check:strict": "tsc -p tsconfig.strict.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext ts,tsx --max-warnings 0",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "compliance:check": "node scripts/compliance-check.mjs",
    "verify": "npm run type-check && npm run type-check:strict && npm run lint && npm run test:coverage && npm run build:all && npm run compliance:check"
  },
  "dependencies": {
    "framer-motion": "^11.3.8",
    "fuse.js": "^7.0.0",
    "lucide-react": "^0.400.0",
    "lz-string": "^1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.0.268",
    "@types/lz-string": "^1.5.0",
    "@types/node": "^25.6.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.40",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.3",
    "vite": "^8.1.4",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.10",
    "vitest-chrome": "^0.1.0"
  }
}
